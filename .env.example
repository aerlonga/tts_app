# Copie este arquivo para .env e preencha
APP_ENV=development
APP_NAME=video-ai-automation
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000

GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TTS_MODEL=gemini-2.5-pro-preview-tts
GEMINI_TEXT_INPUT_COST_PER_1M=0.0
GEMINI_TEXT_OUTPUT_COST_PER_1M=0.0
GEMINI_TTS_INPUT_COST_PER_1M=0.0
GEMINI_TTS_OUTPUT_COST_PER_1M=0.0

YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_REDIRECT_URI=http://localhost:8000/auth/youtube/callback

STORAGE_PATH=storage
TMP_SESSIONS_DIR=/tmp/tts_sessions
TMP_JOBS_DIR=/tmp/tts_jobs
BROLL_DIR=/tmp/broll

DATABASE_URL=sqlite:///storage/app.db

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_ESTIMATED_COST_PER_1M=0.0
GEMINI_EMBEDDING_MODEL=text-embedding-004

FLASK_PORT=5000
FLASK_DEBUG=false
